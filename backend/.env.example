# Database — omit for local SQLite dev; Render injects Postgres in prod
# DATABASE_URL=postgresql://user:password@host:5432/ugc_platform

# Auth — sign creator JWTs (generate a long random string)
AUTH_SECRET=change-me

# Stalvian Marketing Panel (the content source) — /api/ugc/* surface.
# An unset PANEL_API_KEY is not a mock mode: panel calls just fail, and the app
# serves whatever it already holds locally (panel_cache / stories).
PANEL_API_URL=http://localhost:8000
PANEL_API_KEY=
# Shared HMAC secret for the panel's script webhooks (unset -> receiver 503s)
PANEL_WEBHOOK_SECRET=

# Content localization (Claude Haiku)
ANTHROPIC_API_KEY=

# Optional: auto view-tracking for YouTube links
YOUTUBE_API_KEY=

# The two frontend origins allowed through CORS. In production the creator app
# and the admin panel are separate deployments with separate URLs; locally one
# dev server on :3100 serves both, so ADMIN_URL stays empty.
FRONTEND_URL=http://localhost:3100
ADMIN_URL=

# First admin, for a fresh database only. There is no signup endpoint and
# creating a creator requires an existing admin, so without these a brand-new
# deployment has no way in. Applied on startup only while no admin exists —
# it never touches an account that is already there. Clear after first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Stalvian Admin
